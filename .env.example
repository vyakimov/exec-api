# Required: bearer token for exec-api authentication
EXEC_API_TOKEN=your-secret-token

# Required: colon-separated absolute path prefixes that /read-file may read
# under. Keep this as narrow as possible — anything under these prefixes is
# readable by anyone with the token (avoid broad prefixes like $HOME, which
# expose ~/.ssh, ~/.aws, browser profiles, etc.).
EXEC_API_READ_PREFIXES=/path/to/artifacts

# Optional: additional env vars for allowlisted commands
# BEAR_API_TOKEN=your-bear-token
# GOOGLE_PLACES_API_KEY=your-key
